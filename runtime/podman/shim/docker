#!/usr/bin/env bash
# Docker CLI shim for the Podman port.
#
# Upstream's scripts call `docker`. The dune command puts this directory first
# on PATH (see runtime/podman/path.sh) so those calls reach rootful Podman and
# the upstream scripts can stay unmodified. Only behaviour that differs between
# Docker and Podman is translated here; everything else goes to podman as is.
# Nothing here talks to a Docker daemon that may also exist on the host.
set -euo pipefail

DUNE_PODMAN_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../.." && pwd -P)"
DUNE_PODMAN_SOCKET="${DUNE_PODMAN_SOCKET:-/run/podman/podman.sock}"

# Nested `docker` calls (for example from upstream's compose-project.sh) must
# come back through this shim.
case "$PATH" in
  "$DUNE_PODMAN_ROOT/runtime/podman/shim":*) ;;
  *) export PATH="$DUNE_PODMAN_ROOT/runtime/podman/shim:$PATH" ;;
esac

# Docker prints container timestamps as RFC 3339 in UTC; Podman's templates
# print Go's default time format, which date(1) and `logs --since` reject.
DOCKER_TIME_LAYOUT='"2006-01-02T15:04:05.999999999Z07:00"'

podman_cmd=()

shim_die() {
  local code="$1"
  shift
  printf 'docker (dune Podman shim): %s\n' "$*" >&2
  exit "$code"
}

resolve_podman() {
  local bin="${DUNE_PODMAN_BIN:-podman}"
  command -v "$bin" >/dev/null 2>&1 || shim_die 127 "podman was not found in PATH."
  podman_cmd=("$bin")
  if [ -n "${CONTAINER_HOST:-}" ] || [ "$(id -u)" -eq 0 ] || [ "${DUNE_PODMAN_ROOTLESS:-0}" = "1" ]; then
    return 0
  fi
  if [ -S "$DUNE_PODMAN_SOCKET" ] && [ -w "$DUNE_PODMAN_SOCKET" ]; then
    podman_cmd+=(--remote --url "unix://$DUNE_PODMAN_SOCKET")
    return 0
  fi
  shim_die 125 "this stack runs on rootful Podman, which needs root. Run the dune command with sudo (for example: sudo dune status)."
}

run_podman() {
  exec "${podman_cmd[@]}" "$@"
}

podman_socket_gid() {
  if [ ! -S "$DUNE_PODMAN_SOCKET" ] && [ "$(id -u)" -eq 0 ] && command -v systemctl >/dev/null 2>&1; then
    systemctl start podman.socket >/dev/null 2>&1 || true
  fi
  [ -S "$DUNE_PODMAN_SOCKET" ] \
    || shim_die 125 "the Podman API socket $DUNE_PODMAN_SOCKET is missing. Enable it with: sudo systemctl enable --now podman.socket"
  stat -c '%g' "$DUNE_PODMAN_SOCKET"
}

# Containers that mount Docker's socket get the Podman API socket instead. On a
# host that also has Docker (for example Fedora CoreOS), /var/run/docker.sock is
# Docker's own socket and must not be handed to the stack.
rewrite_socket_volume() {
  case "$1" in
    /var/run/docker.sock:* | /run/docker.sock:*)
      printf '%s:%s' "$DUNE_PODMAN_SOCKET" "${1#*:}"
      ;;
    *) return 1 ;;
  esac
}

rewrite_socket_mount() {
  local spec="$1" field out="" rewritten=1
  local IFS=','
  for field in $spec; do
    case "$field" in
      source=/var/run/docker.sock | source=/run/docker.sock | src=/var/run/docker.sock | src=/run/docker.sock)
        field="${field%%=*}=$DUNE_PODMAN_SOCKET"
        rewritten=0
        ;;
    esac
    out="${out:+$out,}$field"
  done
  [ "$rewritten" = 0 ] || return 1
  printf '%s' "$out"
}

# Usage: translate_run <number of command words> <command words...> <args...>
translate_run() {
  local words="$1"
  shift
  local -a head=("${@:1:$words}") out=()
  local arg value rewritten socket_mounted=0 gid
  shift "$words"
  while [ "$#" -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
      -v | --volume)
        value="${1-}"
        [ "$#" -eq 0 ] || shift
        if rewritten="$(rewrite_socket_volume "$value")"; then
          value="$rewritten"
          socket_mounted=1
        fi
        out+=("$arg" "$value")
        ;;
      --volume=*)
        value="${arg#*=}"
        if rewritten="$(rewrite_socket_volume "$value")"; then
          value="$rewritten"
          socket_mounted=1
        fi
        out+=("--volume=$value")
        ;;
      --mount)
        value="${1-}"
        [ "$#" -eq 0 ] || shift
        if rewritten="$(rewrite_socket_mount "$value")"; then
          value="$rewritten"
          socket_mounted=1
        fi
        out+=("$arg" "$value")
        ;;
      --mount=*)
        value="${arg#*=}"
        if rewritten="$(rewrite_socket_mount "$value")"; then
          value="$rewritten"
          socket_mounted=1
        fi
        out+=("--mount=$value")
        ;;
      *) out+=("$arg") ;;
    esac
  done
  if [ "$socket_mounted" = 1 ]; then
    # The Podman socket is root:root 0660, while upstream adds the group of
    # Docker's socket. Keep socket access for non-root container users.
    gid="$(podman_socket_gid)" || exit $?
    head+=(--group-add "$gid")
  fi
  run_podman "${head[@]}" "${out[@]}"
}

rewrite_time_template() {
  local template="$1" field
  for field in StartedAt FinishedAt; do
    template="${template//.State.${field}/(.State.${field}.UTC.Format ${DOCKER_TIME_LAYOUT})}"
  done
  printf '%s' "$template"
}

# Docker prints image IDs as sha256:<hex> everywhere; Podman's inspect templates
# print the bare hex while `image ls --no-trunc` keeps the prefix. Upstream
# compares these IDs (for example to protect in-use images from cleanup).
# Usage: rewrite_image_id_template <template> <Docker field> <Podman field>
# (Podman maps a bare {{.Id}} to its .ID field, but not inside an expression.)
rewrite_image_id_template() {
  printf '%s' "$1" | sed -E "s/(^|[^A-Za-z0-9_.])\\.$2([^A-Za-z0-9_]|\$)/\\1(printf \"sha256:%s\" .$3)\\2/g"
}

# Podman skips the whole batch when one named container does not exist (`rm
# --force` even reports success), while Docker acts on every container it
# finds. Upstream relies on that, for example `docker rm -f dune-server-overmap
# dune-server-survival-1`, so such batches run one container at a time.
# Usage: per_container <number of command words> <command words...> <args...>
per_container() {
  local words="$1"
  shift
  local -a head=("${@:1:$words}") opts=() names=()
  local name rc=0
  shift "$words"
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -t | --time | --timeout | -s | --signal | --cidfile | --filter | --detach-keys)
        opts+=("$1" "${2-}")
        [ "$#" -eq 1 ] || shift
        ;;
      -*) opts+=("$1") ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  [ "${#names[@]}" -gt 1 ] || run_podman "${head[@]}" "${opts[@]}" "${names[@]}"
  for name in "${names[@]}"; do
    "${podman_cmd[@]}" "${head[@]}" "${opts[@]}" "$name" || rc=1
  done
  exit "$rc"
}

rewrite_inspect_template() {
  local template="$1" kind="$2"
  if [ "$kind" = "image" ]; then
    rewrite_image_id_template "$template" Id ID
  else
    rewrite_image_id_template "$(rewrite_time_template "$template")" Image Image
  fi
}

translate_inspect() {
  local -a out=()
  local arg kind=container
  if [ "$1" = "image" ]; then
    kind=image
  fi
  case " $* " in
    *" --type image "* | *" --type=image "*) kind=image ;;
  esac
  while [ "$#" -gt 0 ]; do
    arg="$1"
    shift
    case "$arg" in
      -f | --format)
        out+=("$arg" "$(rewrite_inspect_template "${1-}" "$kind")")
        [ "$#" -eq 0 ] || shift
        ;;
      -f=* | --format=*)
        out+=("${arg%%=*}=$(rewrite_inspect_template "${arg#*=}" "$kind")")
        ;;
      *) out+=("$arg") ;;
    esac
  done
  run_podman "${out[@]}"
}

# `docker builder prune` clears BuildKit's cache. Podman keeps build layers as
# dangling images, and its own `builder prune --all` would delete every unused
# tagged image too (including the Funcom server images), so only dangling
# images are pruned.
translate_builder() {
  [ "${2:-}" = "prune" ] || run_podman "$@"
  shift 2
  local -a out=(image prune --force)
  while [ "$#" -gt 0 ]; do
    case "$1" in
      -a | --all | -f | --force) ;;
      --filter)
        out+=("$1" "${2-}")
        [ "$#" -eq 1 ] || shift
        ;;
      --keep-storage | --reserved-space | --max-used-space | --min-free-space)
        [ "$#" -eq 1 ] || shift
        ;;
      --keep-storage=* | --reserved-space=* | --max-used-space=* | --min-free-space=*) ;;
      *) out+=("$1") ;;
    esac
    shift
  done
  run_podman "${out[@]}"
}

# Docker reports BuildKit's cache as a "Build Cache" row, and upstream's storage
# diagnostics require that row. Podman has no separate build cache.
system_df() {
  local format="" index output row
  local -a args=("$@")
  for ((index = 0; index < ${#args[@]}; index++)); do
    case "${args[index]}" in
      --format) format="${args[index + 1]-}" ;;
      --format=*) format="${args[index]#--format=}" ;;
      -v | --verbose) run_podman system df "${args[@]}" ;;
    esac
  done
  output="$("${podman_cmd[@]}" system df "${args[@]}")"
  printf '%s\n' "$output"
  if grep -q 'Build Cache' <<<"$output"; then
    return 0
  fi
  case "$format" in
    "" | table | "table "*)
      printf '%-15s%-12s%-12s%-12s%s\n' "Build Cache" 0 0 0B "0B (0%)"
      ;;
    json | *"{{json"*) ;;
    *)
      row="$format"
      row="${row//\{\{.Type\}\}/Build Cache}"
      row="${row//\{\{.TotalCount\}\}/0}"
      row="${row//\{\{.Total\}\}/0}"
      row="${row//\{\{.Active\}\}/0}"
      row="${row//\{\{.Size\}\}/0B}"
      row="${row//\{\{.Reclaimable\}\}/0B (0%)}"
      printf '%b\n' "$row"
      ;;
  esac
}

main() {
  resolve_podman
  [ "$#" -gt 0 ] || run_podman
  case "$1" in
    compose)
      shift
      # shellcheck source=runtime/podman/lib/compose.sh
      . "$DUNE_PODMAN_ROOT/runtime/podman/lib/compose.sh"
      dune_compose_main "$@"
      ;;
    run | create) translate_run 1 "$@" ;;
    inspect) translate_inspect "$@" ;;
    image)
      if [ "${2:-}" = "inspect" ]; then
        translate_inspect "$@"
      else
        run_podman "$@"
      fi
      ;;
    builder) translate_builder "$@" ;;
    rm | stop | kill | start | restart | pause | unpause) per_container 1 "$@" ;;
    container)
      case "${2:-}" in
        run | create) translate_run 2 "$@" ;;
        inspect) translate_inspect "$@" ;;
        rm | stop | kill | start | restart | pause | unpause) per_container 2 "$@" ;;
        *) run_podman "$@" ;;
      esac
      ;;
    system)
      if [ "${2:-}" = "df" ]; then
        shift 2
        system_df "$@"
      else
        run_podman "$@"
      fi
      ;;
    *) run_podman "$@" ;;
  esac
}

main "$@"
